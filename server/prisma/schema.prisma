generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum HousingUnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model HousingUnit {
  id          Int                @id @default(autoincrement())
  name        String             @db.VarChar(256)
  status      HousingUnitStatus  @default(AVAILABLE)
  assignments Assignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Occupant {
  id          Int                @id @default(autoincrement())
  firstName   String             @db.VarChar(256)
  lastName    String             @db.VarChar(256)
  email       String             @unique @db.VarChar(256)
  assignments Assignment[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model Assignment {
  id            Int         @id @default(autoincrement())
  housingUnitId Int
  occupantId    Int         @unique
  assignedAt    DateTime    @default(now())

  housingUnit   HousingUnit @relation(fields: [housingUnitId], references: [id], onDelete: Cascade)
  occupant      Occupant    @relation(fields: [occupantId], references: [id], onDelete: Cascade)

  @@index([housingUnitId])
}